-- Spawner Tab
addButton(spawnerTab, "📦 เสกไอเทมทั้งหมด", function()
    pcall(function()
        local backpack = player:FindFirstChildOfClass("Backpack")
        if not backpack then return end
        local function give(folder)
            if not folder then return end
            for _, item in pairs(folder:GetDescendants()) do
                if item:IsA("Tool") then item:Clone().Parent = backpack end
            end
        end
        give(ReplicatedStorage)
        give(ServerStorage)
    end)
end)

-- ลูปหลักการทำงาน
RunService.RenderStepped:Connect(function()
    pcall(function()
        if config.ESPEnabled then
            updateEspTags()
        end
        
        if config.HitboxFOVEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = p.Character.HumanoidRootPart
                    if not originalSizes[rootPart] then originalSizes[rootPart] = rootPart.Size end
                    rootPart.Size = Vector3.new(config.HitboxSize, config.HitboxSize, config.HitboxSize)
                    rootPart.Transparency = 1
                    rootPart.CanCollide = false
                end
            end
        end

        -- ระบบล็อคเฉพาะฆาตรกรภายในวงกลม FOV ตรงกลางหน้าจอเท่านั้น
        if config.MurdererLockEnabled then
            local viewportSize = camera.ViewportSize
            local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
            
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and isMurderer(p) and p.Character and p.Character:FindFirstChild("Head") then
                    local head = p.Character.Head
                    local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    
                    if onScreen and distance <= config.FOVRadius then
                        camera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)
                    end
                end
            end
        end
    end)
end)

