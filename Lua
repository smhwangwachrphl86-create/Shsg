-- ฟังก์ชันเช็คฆาตรกร
local function isMurderer(p)
    if p and p.Character then
        if p.Character:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife") then
            return true
        end
    end
    return false
end

-- ระบบ ESP บทบาท (ฆาตรกรสีแดง, นายอำเภอสีน้ำเงิน, คนธรรมดาสีเขียว)
local function updateEspTags()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
            local head = p.Character.Head
            local billboard = head:FindFirstChild("RoleESPBillTag")
            
            if config.ESPEnabled then
                if not billboard then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = "RoleESPBillTag"
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = head
                    
                    local txtLabel = Instance.new("TextLabel", billboard)
                    txtLabel.Name = "TagText"
                    txtLabel.Size = UDim2.new(1, 0, 1, 0)
                    txtLabel.BackgroundTransparency = 1
                    txtLabel.TextStrokeTransparency = 0.5
                    txtLabel.TextSize = 14
                    txtLabel.Font = Enum.Font.GothamBold
                end
                
                -- ค่าเริ่มต้น คนธรรมดา สีเขียว
                local role = "Innocent 🟢"
                local roleColor = Color3.fromRGB(0, 255, 0)
                
                if p.Character:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun") then
                    role = "Sheriff 🔵"
                    roleColor = Color3.fromRGB(0, 120, 255) -- สีน้ำเงิน
                elseif isMurderer(p) then
                    role = "Murderer 🔴"
                    roleColor = Color3.fromRGB(255, 0, 0) -- สีแดง
                end
                
                local tagText = billboard:FindFirstChild("TagText")
                if tagText then
                    tagText.Text = p.Name .. "\n[" .. role .. "]"
                    tagText.TextColor3 = roleColor
                end
            else
                if billboard then billboard:Destroy() end
            end
        end
    end
end

-- MM2 Tab
addToggle(mm2Tab, "🪙 ออโต้ฟาร์มเหรียญ", false, function(state)
    config.AutoFarm = state
    task.spawn(function()
        while config.AutoFarm do
            task.wait(0.5)
            pcall(function()
                local coinContainer = Workspace:FindFirstChild("CoinContainer")
                if coinContainer then
                    for _, coin in ipairs(coinContainer:GetChildren()) do
                        if not config.AutoFarm then break end
                        if coin:IsA("BasePart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            player.Character.HumanoidRootPart.CFrame = coin.CFrame
                            task.wait(0.2)
                        end
                    end
                end
            end)
        end
    end)
end)

addToggle(mm2Tab, "👁️ ESP ชื่อ + บทบาทบนหัว", false, function(state)
