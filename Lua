local function createTab(name)
    local tabContent = Instance.new("ScrollingFrame", contentArea)
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.BorderSizePixel = 0
    tabContent.ScrollBarThickness = 2
    tabContent.Visible = false
    
    local layout = Instance.new("UIListLayout", tabContent)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabContent.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    local tabBtn = Instance.new("TextButton", sidebar)
    tabBtn.Size = UDim2.new(1, 0, 0, 28)
    tabBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
    tabBtn.TextSize = 11
    tabBtn.Font = Enum.Font.GothamSemibold
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    tabBtn.MouseButton1Click:Connect(function()
        for _, child in pairs(contentArea:GetChildren()) do
            if child:IsA("ScrollingFrame") then child.Visible = false end
        end
        tabContent.Visible = true
    end)

    if #contentArea:GetChildren() <= 1 then
        tabContent.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 200)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    return tabContent
end

local function addToggle(tab, text, defaultState, callback)
    local toggled = defaultState
    local frame = Instance.new("TextButton", tab)
    frame.Size = UDim2.new(1, -5, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    frame.Text = ""
    frame.AutoButtonColor = false
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -45, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(230, 230, 240)
    label.TextSize = 11
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBox = Instance.new("Frame", frame)
    toggleBox.Size = UDim2.new(0, 32, 0, 16)
    toggleBox.Position = UDim2.new(1, -38, 0.5, -8)
    toggleBox.BackgroundColor3 = toggled and Color3.fromRGB(255, 100, 200) or Color3.fromRGB(35, 35, 45)
    Instance.new("UICorner", toggleBox).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame", toggleBox)
    circle.Size = UDim2.new(0, 12, 0, 12)
    circle.Position = toggled and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    circle.BackgroundColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    frame.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            TweenService:Create(toggleBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 100, 200)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -14, 0.5, -6), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        else
            TweenService:Create(toggleBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 45)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Color3.fromRGB(150, 150, 160)}):Play()
        end
        if callback then pcall(function() callback(toggled) end) end
    end)
end

